{
  "openapi": "3.0.3",
  "info": {
    "title": "CodeArena API",
    "description": "API REST pour la plateforme d'affrontement tactique de bots en 2D CodeArena (SAÉ BUT3 Informatique).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur de développement local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "timestamp": { "type": "string", "format": "date-time" },
          "database": { "type": "string", "example": "Connected" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "example": "CyberPilot42", "minLength": 3, "maxLength": 30 },
          "email": { "type": "string", "format": "email", "example": "pilote@codearena.io" },
          "password": { "type": "string", "format": "password", "minLength": 6, "example": "securePassword123" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "CyberPilot42" },
          "password": { "type": "string", "format": "password", "example": "securePassword123" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Connexion réussie." },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": {
            "type": "object",
            "properties": {
              "player_id": { "type": "integer", "example": 1 },
              "username": { "type": "string", "example": "CyberPilot42" },
              "email": { "type": "string", "example": "pilote@codearena.io" },
              "elo_rank": { "type": "integer", "example": 1000 }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Identifiants invalides." }
        }
      },
      "ClassFunction": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "charge" },
          "signature": { "type": "string", "example": "charge(direction)" },
          "ap_cost": { "type": "integer", "example": 3 },
          "description": { "type": "string", "example": "Fonce vers un ennemi proche et inflige des dégâts renforcés." }
        }
      },
      "ClassStats": {
        "type": "object",
        "properties": {
          "health": { "type": "integer", "example": 100 },
          "range": { "type": "integer", "example": 1 },
          "damage": { "type": "integer", "example": 25 },
          "action_points": { "type": "integer", "example": 3 }
        }
      },
      "GameClass": {
        "type": "object",
        "properties": {
          "class_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Guerrier" },
          "description": { "type": "string", "example": "Combattant polyvalent spécialisé dans le corps à corps et les assauts rapides." },
          "base_health": { "type": "integer", "example": 100 },
          "base_range": { "type": "integer", "example": 1 },
          "base_damage": { "type": "integer", "example": 25 },
          "base_action_points": { "type": "integer", "example": 3 },
          "stats": { "$ref": "#/components/schemas/ClassStats" },
          "available_functions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ClassFunction" }
          },
          "required_mission_id": { "type": "integer", "nullable": true, "example": null }
        }
      },
      "ClassesListResponse": {
        "type": "object",
        "properties": {
          "classes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GameClass" }
          }
        }
      },
      "ClassDetailResponse": {
        "type": "object",
        "properties": {
          "class": { "$ref": "#/components/schemas/GameClass" }
        }
      },
      "Script": {
        "type": "object",
        "properties": {
          "script_id": { "type": "integer", "example": 1 },
          "player_id": { "type": "integer", "example": 1 },
          "match_id": { "type": "integer", "nullable": true, "example": null },
          "class_id": { "type": "integer", "nullable": true, "example": 1 },
          "code_content": { "type": "string", "example": "def on_tick(game):\n    game.wait()" },
          "round_number": { "type": "integer", "example": 1 },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SaveScriptRequest": {
        "type": "object",
        "required": ["code_content"],
        "properties": {
          "code_content": { "type": "string", "example": "def on_tick(game):\n    game.wait()" },
          "class_id": { "type": "integer", "nullable": true, "example": 1 },
          "script_id": { "type": "integer", "nullable": true, "example": 1 },
          "match_id": { "type": "integer", "nullable": true, "example": null },
          "round_number": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "ScriptResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Script sauvegardé avec succès." },
          "script": { "$ref": "#/components/schemas/Script" }
        }
      },
      "SelectClassRequest": {
        "type": "object",
        "required": ["class_id"],
        "properties": {
          "class_id": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "SelectedClassResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Classe sélectionnée pour le prochain match." },
          "selected_class_id": { "type": "integer", "nullable": true, "example": 1 },
          "selected_class": { "$ref": "#/components/schemas/GameClass" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Vérification de l'état de l'API et de PostgreSQL",
        "responses": {
          "200": {
            "description": "Système opérationnel",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          },
          "500": {
            "description": "Erreur serveur ou base de données inaccessible"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Inscription d'un nouveau pilote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compte créé avec succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "description": "Données invalides ou incomplètes" },
          "409": { "description": "Nom d'utilisateur ou email déjà existant" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Connexion et obtention du jeton JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "description": "Identifiant ou mot de passe manquant" },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Profil et classes débloquées du pilote connecté",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Données du profil" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Utilisateur introuvable" }
        }
      }
    },
    "/classes": {
      "get": {
        "summary": "Liste des classes de bots avec statistiques et capacités disponibles",
        "responses": {
          "200": {
            "description": "Liste des classes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassesListResponse" }
              }
            }
          },
          "500": {
            "description": "Erreur serveur lors de la récupération des classes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/classes/selected": {
      "get": {
        "summary": "Consulter la classe sélectionnée par le pilote connecté pour son prochain match",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Classe sélectionnée (ou null)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SelectedClassResponse" }
              }
            }
          },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/classes/select": {
      "post": {
        "summary": "Enregistrer le choix de classe d'un joueur pour son prochain match",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SelectClassRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Classe sélectionnée avec succès",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SelectedClassResponse" }
              }
            }
          },
          "400": { "description": "Identifiant de classe invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou classe verrouillée" },
          "404": { "description": "Classe ou utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      },
      "put": {
        "summary": "Mettre à jour le choix de classe d'un joueur pour son prochain match",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SelectClassRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Classe sélectionnée avec succès" },
          "400": { "description": "Identifiant de classe invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou classe verrouillée" },
          "404": { "description": "Classe ou utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/classes/{id}": {
      "get": {
        "summary": "Détail d'une classe de bot par identifiant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Détail de la classe",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassDetailResponse" }
              }
            }
          },
          "400": {
            "description": "Identifiant de classe invalide",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Classe introuvable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Erreur serveur lors de la récupération de la classe",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/classes": {
      "get": {
        "summary": "Liste des classes de robots disponibles (alias /classes)",
        "responses": {
          "200": {
            "description": "Liste des classes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassesListResponse" }
              }
            }
          },
          "500": {
            "description": "Erreur serveur lors de la récupération des classes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/classes/selected": {
      "get": {
        "summary": "Consulter la classe sélectionnée par le pilote connecté (alias /classes/selected)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Classe sélectionnée (ou null)" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/api/classes/select": {
      "post": {
        "summary": "Enregistrer le choix de classe d'un joueur (alias /classes/select)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SelectClassRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Classe sélectionnée avec succès" },
          "400": { "description": "Identifiant de classe invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou classe verrouillée" },
          "404": { "description": "Classe ou utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      },
      "put": {
        "summary": "Mettre à jour le choix de classe d'un joueur (alias /classes/select)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SelectClassRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Classe sélectionnée avec succès" },
          "400": { "description": "Identifiant de classe invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou classe verrouillée" },
          "404": { "description": "Classe ou utilisateur introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/api/classes/{id}": {
      "get": {
        "summary": "Détail d'une classe de robot par identifiant (alias /classes/{id})",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Détail de la classe",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClassDetailResponse" }
              }
            }
          },
          "400": {
            "description": "Identifiant de classe invalide",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Classe introuvable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Erreur serveur lors de la récupération de la classe",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/missions": {
      "get": {
        "summary": "Liste des missions tactiques et conditions de déblocage",
        "responses": {
          "200": { "description": "Liste des missions" }
        }
      }
    },
    "/scripts": {
      "post": {
        "summary": "Enregistrer ou mettre à jour le script du pilote connecté",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveScriptRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Script mis à jour",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScriptResponse" }
              }
            }
          },
          "201": {
            "description": "Script sauvegardé",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScriptResponse" }
              }
            }
          },
          "400": { "description": "Données de script invalides" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Script ciblé introuvable" },
          "500": { "description": "Erreur interne" }
        }
      },
      "get": {
        "summary": "Récupérer le dernier script sauvegardé du pilote connecté",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Dernier script du pilote",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "script": { "$ref": "#/components/schemas/Script" }
                  }
                }
              }
            }
          },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Aucun script sauvegardé" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/scripts/{id}": {
      "get": {
        "summary": "Récupérer un script par identifiant (ou alias latest/me)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "latest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Script trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "script": { "$ref": "#/components/schemas/Script" }
                  }
                }
              }
            }
          },
          "400": { "description": "Identifiant de script invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Script introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/api/scripts": {
      "post": {
        "summary": "Enregistrer ou mettre à jour le script du pilote connecté (alias /scripts)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveScriptRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Script mis à jour" },
          "201": { "description": "Script sauvegardé" },
          "400": { "description": "Données de script invalides" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Script ciblé introuvable" },
          "500": { "description": "Erreur interne" }
        }
      },
      "get": {
        "summary": "Récupérer le dernier script sauvegardé du pilote connecté (alias /scripts)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dernier script du pilote" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Aucun script sauvegardé" },
          "500": { "description": "Erreur interne" }
        }
      }
    },
    "/api/scripts/{id}": {
      "get": {
        "summary": "Récupérer un script par identifiant ou alias latest/me (alias /scripts/{id})",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "latest" }
          }
        ],
        "responses": {
          "200": { "description": "Script trouvé" },
          "400": { "description": "Identifiant de script invalide" },
          "401": { "description": "Token manquant" },
          "403": { "description": "Token invalide ou expiré" },
          "404": { "description": "Script introuvable" },
          "500": { "description": "Erreur interne" }
        }
      }
    }
  }
}
